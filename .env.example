# ─── Binary Agent — environment manifest (SHAPES ONLY, never values) ─────────
# The public repo must contain no secrets (GitHub Push Protection blocks
# leaked AI keys — treat that as a backstop, not a control).

# Telegram
AGENT_BOT_TOKEN=            # bot token from @BotFather
AGENT_WEBHOOK_SECRET=       # 32+ random chars; must byte-match setWebhook secret_token
AGENT_TICK_SECRET=          # 32+ random chars; guards /tick + /setup-db + dashboard

# Agent runtime
AGENT_GH_TOKEN=             # PAT with repo scope — memory writes + workflow dispatch
AGENT_MEMORY_REPO=bessghiermohamed/binary-agent-memory
AGENT_SCHEDULER_REPO=bessghiermohamed/binary-agent
AGENT_OWNER_CHAT_ID=        # optional preset owner (else pinned on first DM)

# Supabase semantic memory (optional — mirrors fail safe without it)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=       # service-role JWT
SUPABASE_DB_PASSWORD=       # for setup-db DDL via pooler

# LLM cortex — any subset; missing keys skip that provider
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
CF_API_TOKEN=               # Workers AI: llama-3.1-8b chat + bge-m3 embeddings
CF_ACCOUNT_ID=              # builds the Workers AI URL
GROK_API_KEY=               # dormant — no credits
GROQ_API_KEY=               # dormant — region-blocked
HF_API_KEY=                 # dormant — intermittent CF block

# Optional per-provider model overrides
# MODEL_GEMINI=gemini-flash-latest
# MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct
# MODEL_POLLINATIONS_MISTRAL=mistral
