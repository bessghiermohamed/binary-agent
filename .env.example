# Binary Agent — environment variables (names only, never real values)
# Copy to .env.local for local runs; production values live in Vercel envs.

# identity / integrations
AGENT_BOT_TOKEN=
AGENT_WEBHOOK_SECRET=
AGENT_TICK_SECRET=
AGENT_OWNER_CHAT_ID=
AGENT_GH_TOKEN=
AGENT_MEMORY_REPO=bessghiermohamed/binary-agent-memory
AGENT_SCHEDULER_REPO=bessghiermohamed/binary-agent

# optional semantic mirror (paused projects are tolerated — GitHub is canonical)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_DB_PASSWORD=

# LLM cortex racers (all optional; keyless pollinations always available)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
HF_API_KEY=
GROK_API_KEY=
GROQ_API_KEY=
CF_API_TOKEN=
CF_ACCOUNT_ID=

# per-provider model overrides (e.g. if an alias retires again)
# MODEL_GEMINI=gemini-3.6-flash
# MODEL_COHERE=command-r-plus-08-2024
# MODEL_MISTRAL=mistral-small-latest
# MODEL_CLOUDFLARE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# MODEL_HUGGINGFACE=meta-llama/Llama-3.3-70B-Instruct
# MODEL_HUGGINGFACE_QWEN=Qwen/Qwen2.5-72B-Instruct
# MODEL_GROQ=llama-3.3-70b-versatile
# MODEL_GROK=grok-3-mini
